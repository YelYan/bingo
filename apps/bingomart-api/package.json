{
  "name": "bingomart-api",
  "version": "0.1.0",
  "private": true,
  "description": "BingoMart API: NestJS modular monolith on PostgreSQL.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node scripts/dev.mjs",
    "migrate": "node scripts/migrate.mjs",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node scripts/dev.mjs --test"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "22.15.3",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.8.3"
  },
  "type": "module"
}
