{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bingo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "bingo-site", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "bingo-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "bingo-site", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "bingo-workers",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--port", "8787"],
      "port": 8787,
      "autoPort": true
    }
  ]
}
